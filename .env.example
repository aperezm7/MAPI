# Required-ish: identify this app to GBIF (they ask for a descriptive User-Agent).
GBIF_USER_AGENT=MAPI/0.1 (species occurrence maps; research/education)

# Optional Redis cache (falls back to in-memory TTL cache).
# REDIS_URL=redis://localhost:6379/0

# Optional IUCN Red List API v4 (species-page status only; map filters use GBIF).
# IUCN_API_TOKEN=

# Natural-language planner (optional). Leave LLM_PROVIDER unset (= auto) and the
# first hosted key found wins, in this order: OpenAI, Gemini, Groq, OpenRouter.
# With no key, MAPI uses local Ollama (http://127.0.0.1:11434/v1, model gemma4).
# LLM_PROVIDER=auto          # auto | openai | gemini | groq | openrouter | ollama | openai_compatible
# GROQ_API_KEY=              # https://console.groq.com/keys  (default model openai/gpt-oss-20b)
# GEMINI_API_KEY=            # https://aistudio.google.com/apikey  (default model gemini-3.8-flash)
# OPENAI_API_KEY=            # https://platform.openai.com/api-keys  (default model gpt-4o-mini)
# OPENROUTER_API_KEY=        # https://openrouter.ai/keys  (default model openai/gpt-oss-20b)

# Overrides for any provider:
# LLM_MODEL=
# LLM_API_KEY=
# LLM_BASE_URL=              # required for LLM_PROVIDER=openai_compatible
# LLM_TIMEOUT_SECONDS=       # 60 for hosted providers, 180 for Ollama
# LLM_JSON_MODE=true         # send response_format=json_object (auto-retried without it on 400)

# Local Ollama:
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=gemma4

# Optional server-wide GBIF account for async full occurrence downloads.
# A client can instead connect its own GBIF login in the Account card; that password
# is encrypted with MAPI_SECRET_KEY and used only for that client's downloads.
# GBIF_USERNAME=
# GBIF_PASSWORD=
# GBIF_DOWNLOAD_EMAIL=

# Clients, quotas, and credit costs. AUTH_REQUIRED=false leaves the API open and
# records queries under an unlimited "Open access" client. Set it true to require
# Authorization: Bearer <api key>. Create keys with X-Admin-Token: $MAPI_ADMIN_TOKEN.
# AUTH_REQUIRED=false
# MAPI_ADMIN_TOKEN=
# MAPI_SECRET_KEY=
# DATABASE_PATH=data/mapi.sqlite
# QUOTA_MAPS_PER_DAY=100
# QUOTA_PLANS_PER_DAY=40
# QUOTA_REQUESTS_PER_MINUTE=30
# DEFAULT_BUDGET=100
# COST_MAP=1
# COST_PLAN=2
# COST_RESOLVE=0.1
# COST_DOWNLOAD=5
# COST_EXPORT=1
# COST_INAT=0.2

CORS_ORIGINS=http://localhost:5173,http://localhost:8080
