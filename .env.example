# Required-ish: identify this app to GBIF (they ask for a descriptive User-Agent).
GBIF_USER_AGENT=MAPI/0.1 (species occurrence maps; research/education)

# Optional Redis cache (falls back to in-memory TTL cache).
# REDIS_URL=redis://localhost:6379/0

# Optional IUCN Red List API v4 (species-page status only; map filters use GBIF).
# IUCN_API_TOKEN=

# Optional OpenAI-compatible LLM for natural-language MapQuery planning.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Optional GBIF account for async full occurrence downloads.
# GBIF_USERNAME=
# GBIF_PASSWORD=
# GBIF_DOWNLOAD_EMAIL=

CORS_ORIGINS=http://localhost:5173,http://localhost:8080
